# Static release identity for this package. Load it before any helper action:
#
#   set -a; . scripts/npm/target.env; set +a
#
# Per-release values are never stored here: PKG_VERSION, SOURCE_SHA, ARTIFACT,
# and ARTIFACT_INTEGRITY are exported by the release owner for one release only.

PKG_NAME='@sagmans/dsh-plannotator'
REPO='sagmans/dsh-plannotator'
REGISTRY='https://registry.npmjs.org/'
NPM_USER='assagman'
WORKFLOW_FILE='release.yml'
ENVIRONMENT='npm-release'
# Named bypass actor on the admin-only tag ruleset; a role bypass is dropped when
# the repository changes owner, and the tag push is the only release approval.
RELEASE_OWNER='assagman'
TAG_PATTERN='v*'
RULESET_NAME='release-tags-admin-only'
